# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Secrets — never commit real credentials
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
iecepnational credentials.txt
UserList.xlsx
~$*.xlsx
~$*.xls

# Build artifacts staged for manual upload (not source)
dist.zip

# SQLite database (local runtime data, not source)
server/prisma/*.db
server/prisma/*.db-journal

# Uploaded files (runtime data, not source)
server/uploads/*
!server/uploads/.gitkeep

# Claude Code local settings/runtime state (machine-specific)
.claude/settings.local.json
.claude/*.lock

# Editor / OS
.DS_Store
Thumbs.db
*.local

# Logs
npm-debug.log*
